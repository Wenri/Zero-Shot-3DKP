        {
            "name": "Debug Line Plot",
            "type": "debugpy",
            "request": "launch",
            "program": "line_plot.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Debug Molmo",
            "type": "debugpy",
            "request": "launch",
            "program": "data_creation/molmo.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "CUDA_VISIBLE_DEVICES": "1",
            }
        },
        {
            "name": "Debug Pixmo Points",
            "type": "debugpy",
            "request": "launch",
            "program": "data_creation/pixmo-points.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "CUDA_VISIBLE_DEVICES": "1",
            }
        },
        {
            "name": "Download Data",
            "type": "debugpy",
            "request": "launch",
            "program": "molmo/scripts/download_data.py",
            "args": ["OkVqa", "--n_proc", "12"],
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "HF_HOME": "/data/bingchen/molmo/huggingface",
                "MOLMO_DATA_DIR": "/data/bingchen/molmo"
            }
        },
        {
            "name": "Run MM Eval",
            "type": "debugpy",
            "request": "launch",
            "module": "torch.distributed.run",
            "args": [
                "--nproc_per_node=1",
                "--nnodes=1",
                "launch_scripts/eval_downstream.py",
                "/data/bingchen/molmo/checkpoints/olmo-1024-preview",
                "pointing_eval",
                "--save_to_checkpoint_dir"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}/molmo",
            "env": {
                "CUDA_VISIBLE_DEVICES": "1",
                "HF_HOME": "/data/bingchen/molmo/huggingface",
                "MOLMO_DATA_DIR": "/data/bingchen/molmo",
                "PYTHONPATH": "${workspaceFolder}/molmo"
            }
        },
        {
            "name": "Run Multitask Training",
            "type": "debugpy",
            "request": "launch",
            "module": "torch.distributed.run",
            "args": [
                "--nproc_per_node=10",
                "--nnodes=1",
                "launch_scripts/train_multitask_model.py",
                "pointing",
                "/data/bingchen/molmo/checkpoints/Molmo-7B-D-0924-Point",
                "--wandb=null",
                "--save_folder=/data/bingchen/molmo/checkpoints/Molmo-7B-D-0924-Save",
                "--save_overwrite",
                "--global_batch_size=240",
                "--device_train_batch_size=2",
                "--device_eval_batch_size=2",
                "--device_inf_batch_size=2"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}/molmo",
            "env": {
                "HF_HOME": "/data/bingchen/molmo/huggingface",
                "MOLMO_DATA_DIR": "/data/bingchen/molmo",
                "PYTHONPATH": "${workspaceFolder}/molmo",
                "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True",
                "OMP_NUM_THREADS": "12"
            }
        }
    ]
}